@bot.message_handler(func=lambda message: True)
def handle_message(message):
    bot.send_message(message.chat.id, translate_mes(message.text))
    print(f'[{message.from_user.first_name}] - {message.text}')
    # with open("C:/Users/andre/PycharmProjects/telega_bot v2.0/logs_users.txt", 'a') as file:
    #     file.write(f'[{message.forward_date}|{message.from_user.first_name}] - {message.text}\n')

@bot.message_handler(content_types=['photo'])
def photo_translate(message):
    bot.send_message(message.chat.id, 'В разработке')
    photo_info = message.photo[-1]
    file_id = photo_info.file_id
    file_path = bot.get_file(file_id).file_path
    downloaded_file = bot.download_file(file_path)
    save_path = "C:/Users/andre/PycharmProjects/telega_bot v2.0/image"
    if not os.path.exists(save_path):
        os.makedirs(save_path)
    file_name = f'{file_id}.png'
    with open(os.path.join(save_path, file_name), 'wb') as new_file:
        new_file.write(downloaded_file)
    # bot.send_photo(message.chat.id, open(os.path.join(save_path, file_name), 'rb'))
    print(pytesseract.image_to_string(Image.open(save_path + '/' + file_name), lang='rus'))
    txt_orig = pytesseract.image_to_string(Image.open(save_path + '/' + file_name), lang='rus')
    bot.send_message(message.chat_id, translate_mes(txt_orig))
        # bot.send_message(translate_mes(pytesseract.image_to_string(image)))



bot.polling(none_stop=True, interval=0)
