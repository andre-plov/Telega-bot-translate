from telebot import *
from translate import Translator
from PIL import Image
import pytesseract
import os

Lang_out = 'en'

bot = telebot.TeleBot('YOUR_TOKEN') # Enter your bot-token
bot.delete_webhook()

# logs = open('logs_users.txt', '')


def translate_mes(text):  # core translator
    global Lang_out
    translator = Translator(from_lang='ru', to_lang=Lang_out)
    translation = str(translator.translate(text))
    return translation


@bot.message_handler(commands=['start'])
def start(message):
    bot.send_message(message.chat.id,
                     'Привет-привет👋\nЭто бот-переводчик, для вывода списка языков\n(по умолчанию это английский) используй комманду \n/lang\n\nДля озвучивания перевода используй комманду /voice и бот отправит аудио версию последнего переведённого сообщения')


@bot.message_handler(commands=['lang'])
def lang(message):
    bot.send_message(message.chat.id,
                     'Выбери язык из списка ниже👇\n   Английский - /en\n   Французский - /fr\n   Испанский - /es\n   Корейский - /ko\n   Арабский - /ar\n   Японский - /ja')


@bot.message_handler(commands=['voice'])
def voice(message):
    bot.send_message(message.chat.id, 'Функция пока в разработке')
    # voice01 = open("PATH_SAVE")
    # bot.send_audio(message.chat.id, voice01)
    # voice01.close()


@bot.message_handler(commands=['en'])  # block for swap language and message about at
def lang_english(message):
    global Lang_out
    Lang_out = 'en'
    bot.send_message(message.chat.id, 'Язык успешно изменён на Английский 🇬🇧')


